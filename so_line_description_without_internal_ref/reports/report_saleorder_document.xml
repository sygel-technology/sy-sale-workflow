<odoo>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
    >
        <xpath expr="//td[@name='td_name']/span" position="attributes">
            <attribute name="t-field" />
            <attribute
                name="t-out"
            >line.name.replace('[{}]'.format(line.product_id.default_code), '')</attribute>
        </xpath>
    </template>
</odoo>
