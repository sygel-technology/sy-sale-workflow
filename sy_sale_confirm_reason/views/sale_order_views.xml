<odoo>
    <record id="view_order_form_confirm_reason" model="ir.ui.view">
        <field name="name">sale.order.form.confirm.reason</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_header']" position="before">
                <group name="confirm_reason" invisible="not confirm_reason_id">
                    <field
                        name="confirm_reason_id"
                        options="{'no_create': True, 'no_open': True}"
                        colspan="2"
                    />
                    <field
                        name="confirm_reason_details"
                        invisible="not confirm_reason_details"
                        colspan="2"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
