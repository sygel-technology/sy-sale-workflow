<odoo>
    <record id="res_config_settings_view_form_sale_confirm_reason" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.sale.confirm.reason
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="order_warnings" position="after">
                <setting
                    id="sale_confirm_reason"
                    string="Sale Confirmation Reason"
                    help="Ask for a reason when confirming a sales order."
                    company_dependent="1"
                >
                    <field name="sale_confirm_reason" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
