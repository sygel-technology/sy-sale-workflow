<odoo>
    <record id="view_order_form_mandate_position" model="ir.ui.view">
        <field name="name">sale.order.form.mandate.position</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="account_banking_mandate_sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="mandate_id" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>

            <field name="payment_mode_id" position="after">
                <field name="mandate_id" invisible="not mandate_required" />
            </field>
        </field>
    </record>
</odoo>
